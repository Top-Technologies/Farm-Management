<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- noupdate="0": re-applied on every upgrade so group changes take effect -->
    <data noupdate="0">
        <!-- Module Category: makes groups appear as a row in Settings > Users -->
        <record id="module_category_farm" model="ir.module.category">
            <field name="name">Farm Management</field>
            <field name="sequence">25</field>
        </record>

        <!-- User Group -->
        <record id="group_farm_user" model="res.groups">
            <field name="name">User</field>
            <field name="category_id" ref="module_category_farm"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Administrator Group: auto-assigned to Odoo admin users on install/upgrade -->
        <record id="group_farm_manager" model="res.groups">
            <field name="name">Administrator</field>
            <field name="category_id" ref="module_category_farm"/>
            <field name="implied_ids" eval="[(4, ref('group_farm_user')), (4, ref('hr.group_hr_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>
    </data>

    <!-- noupdate="1": record rules only created once; manual edits are preserved -->
    <data noupdate="1">
        <record id="farm_farm_company_rule" model="ir.rule">
            <field name="name">Farm Multi-Company Rule</field>
            <field name="model_id" ref="model_farm_farm"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="farm_sub_farm_company_rule" model="ir.rule">
            <field name="name">Sub Farm Multi-Company Rule</field>
            <field name="model_id" ref="model_farm_sub_farm"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="farm_sub_unit_company_rule" model="ir.rule">
            <field name="name">Sub Unit Multi-Company Rule</field>
            <field name="model_id" ref="model_farm_sub_unit"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="farm_block_company_rule" model="ir.rule">
            <field name="name">Block Multi-Company Rule</field>
            <field name="model_id" ref="model_farm_block"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="farm_activity_company_rule" model="ir.rule">
            <field name="name">Farm Activity Multi-Company Rule</field>
            <field name="model_id" ref="model_farm_activity"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="farm_activity_norm_company_rule" model="ir.rule">
            <field name="name">Farm Activity Norm Multi-Company Rule</field>
            <field name="model_id" ref="model_farm_activity_norm"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="farm_temporary_rate_company_rule" model="ir.rule">
            <field name="name">Farm Temporary Rate Multi-Company Rule</field>
            <field name="model_id" ref="model_farm_temporary_rate"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="farm_employee_transfer_company_rule" model="ir.rule">
            <field name="name">Farm Employee Transfer Multi-Company Rule</field>
            <field name="model_id" ref="model_farm_employee_transfer"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="farm_work_entry_company_rule" model="ir.rule">
            <field name="name">Farm Work Entry Multi-Company Rule</field>
            <field name="model_id" ref="model_farm_work_entry"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="hr_salary_matrix_company_rule" model="ir.rule">
            <field name="name">Salary Matrix Multi-Company Rule</field>
            <field name="model_id" ref="model_hr_salary_matrix"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
