<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Activity List View -->
    <record id="view_farm_activity_list" model="ir.ui.view">
        <field name="name">farm.activity.list</field>
        <field name="model">farm.activity</field>
        <field name="arch" type="xml">
            <list string="Farm Activities">
                <field name="name"/>
                <field name="code"/>
                <field name="crop_name" optional="show"/>
                <field name="cost_category" optional="show"/>
                <field name="main_activity" optional="show"/>
                <field name="sub_activity" optional="show"/>
                <field name="type" widget="badge" decoration-info="type == 'piece_rate'" decoration-success="type == 'fixed'"/>
                <field name="uom_name" string="Unit"/>
                <field name="standard_hours" optional="show"/>
                <field name="required_cost" optional="show"/>
                <field name="requires_labor" widget="boolean_toggle" optional="hide"/>
                <field name="requires_machine" widget="boolean_toggle" optional="hide"/>
                <field name="farm_norm_count" string="Configured Farms"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Activity Form View -->
    <record id="view_farm_activity_form" model="ir.ui.view">
        <field name="name">farm.activity.form</field>
        <field name="model">farm.activity</field>
        <field name="arch" type="xml">
            <form string="Farm Activity">
                <sheet>
                    <field name="active" invisible="1"/>
                    <field name="company_id" invisible="1"/>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="e.g. Soil Preparation, Cultivating, Harvesting..."/>
                        </h1>
                        <div class="d-flex align-items-baseline">
                            <label for="code" class="me-2 text-muted" string="Activity ID:"/>
                            <field name="code" placeholder="e.g. SP, CULT, HARV (auto-generated if empty)" style="max-width: 250px; font-weight: bold;"/>
                        </div>
                    </div>
                    <group>
                        <group name="general_specs" string="Activity Specifications">
                            <field name="type" widget="radio" options="{'horizontal': true}"/>
                            <field name="category"/>
                            <field name="uom_name" placeholder="e.g. Birr/Kg, Birr/Day, Ha, Man-Days"/>
                            <field name="activity_type" placeholder="e.g. Operational, Contract"/>
                        </group>
                        <group name="cost_work_specs" string="Operational &amp; Cost Category">
                            <field name="crop_name" placeholder="e.g. Mature Coffee"/>
                            <field name="cost_category" placeholder="e.g. Direct, Indirect, Production"/>
                            <field name="main_activity" placeholder="e.g. Coffee Maintenance"/>
                            <field name="sub_activity" placeholder="e.g. Desuckering, Pruning"/>
                            <field name="standard_hours"/>
                            <field name="required_cost"/>
                            <div class="d-flex gap-4 mt-2">
                                <field name="requires_labor"/>
                                <field name="requires_machine"/>
                            </div>
                        </group>
                    </group>
                    <notebook>
                        <page name="farm_norms" string="Farm Norms &amp; Targets">
                            <field name="farm_norm_ids" context="{'default_activity_id': id}">
                                <list editable="bottom" string="Farm Norms">
                                    <field name="farm_id" options="{'no_create': True}"/>
                                    <field name="norm_value" string="Standard Norm"/>
                                    <field name="uom_name" string="Unit"/>
                                </list>
                            </field>
                        </page>
                        <page name="sop_details" string="Description &amp; Guidelines">
                            <field name="description" placeholder="Standard operating procedures, machine requirements, guidelines..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Activity Kanban View -->
    <record id="view_farm_activity_kanban" model="ir.ui.view">
        <field name="name">farm.activity.kanban</field>
        <field name="model">farm.activity</field>
        <field name="arch" type="xml">
            <kanban default_group_by="category" class="o_kanban_small_column">
                <field name="name"/>
                <field name="code"/>
                <field name="type"/>
                <field name="category"/>
                <field name="uom_name"/>
                <field name="farm_norm_count"/>
                <field name="color"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <h5 class="fw-bold mb-0">
                                <field name="name"/>
                            </h5>
                            <div class="d-flex gap-1">
                                <span class="badge text-bg-primary">
                                    <field name="code"/>
                                </span>
                                <field name="type" widget="badge" decoration-info="type == 'piece_rate'" decoration-success="type == 'fixed'"/>
                            </div>
                        </div>
                        <div class="text-muted small mb-2">
                            <i class="fa fa-tachometer me-1" title="Unit"/> Unit: <span class="fw-medium text-dark"><field name="uom_name"/></span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mt-2 pt-2 border-top">
                            <span class="badge rounded-pill text-bg-light border">
                                <i class="fa fa-university me-1 text-muted" title="Farms"/> <field name="farm_norm_count"/> Farms Configured
                            </span>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Activity Search View -->
    <record id="view_farm_activity_search" model="ir.ui.view">
        <field name="name">farm.activity.search</field>
        <field name="model">farm.activity</field>
        <field name="arch" type="xml">
            <search string="Search Farm Activities">
                <field name="name" string="Activity" filter_domain="['|', '|', ('name', 'ilike', self), ('code', 'ilike', self), ('main_activity', 'ilike', self)]"/>
                <field name="code"/>
                <field name="crop_name"/>
                <field name="cost_category"/>
                <field name="main_activity"/>
                <field name="sub_activity"/>
                <field name="type"/>
                <field name="category"/>
                <separator/>
                <filter string="Fixed (Daily Rate)" name="filter_fixed" domain="[('type', '=', 'fixed')]"/>
                <filter string="Piece Rate" name="filter_piece_rate" domain="[('type', '=', 'piece_rate')]"/>
                <separator/>
                <filter string="Requires Labor" name="filter_labor" domain="[('requires_labor', '=', True)]"/>
                <filter string="Requires Machine" name="filter_machine" domain="[('requires_machine', '=', True)]"/>
                <separator/>
                <filter string="Archived" name="archived" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Crop Name" name="group_crop_name" context="{'group_by': 'crop_name'}"/>
                    <filter string="Cost Category" name="group_cost_cat" context="{'group_by': 'cost_category'}"/>
                    <filter string="Main Activity" name="group_main_act" context="{'group_by': 'main_activity'}"/>
                    <filter string="Type" name="group_type" context="{'group_by': 'type'}"/>
                    <filter string="Category" name="group_category" context="{'group_by': 'category'}"/>
                    <filter string="Company" name="group_company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action Activity -->
    <record id="action_farm_activity" model="ir.actions.act_window">
        <field name="name">Activities</field>
        <field name="res_model">farm.activity</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_farm_activity_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Define your first Farm Activity!
            </p>
            <p>
                Activities define standard agricultural operations (e.g. Soil Preparation [SP], Cultivating [CULT]) and specify productivity norms per farm.
            </p>
        </field>
    </record>
</odoo>
