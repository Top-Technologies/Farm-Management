<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- HR Payslip Form Inherit: Farm Work Entries -->
    <record id="view_hr_payslip_form_farm_inherit" model="ir.ui.view">
        <field name="name">hr.payslip.form.farm.inherit</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="hr_payroll.view_hr_payslip_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='contract_id']" position="after">
                <field name="farm_employee_type" widget="badge" decoration-success="farm_employee_type in ('permanent', 'head_office', 'cpw')" decoration-warning="farm_employee_type == 'temporary'" decoration-info="farm_employee_type == 'zemach'"/>
                <field name="salary_matrix_type" invisible="farm_employee_type in ('temporary', 'zemach') or not salary_matrix_type"/>
                <field name="salary_grade" invisible="farm_employee_type in ('temporary', 'zemach') or not salary_grade"/>
                <field name="salary_level" invisible="farm_employee_type in ('temporary', 'zemach') or not salary_level"/>
                <field name="matrix_basic_wage" widget="monetary" invisible="farm_employee_type in ('temporary', 'zemach') or matrix_basic_wage == 0"/>
                <field name="farm_id" invisible="not farm_id"/>
                <field name="sub_unit_id" invisible="not sub_unit_id"/>
            </xpath>

            <notebook position="inside">
                <page string="Farm Work Entries" name="farm_work_entries" invisible="farm_work_entries_count == 0">
                    <div class="alert alert-info d-flex align-items-center mb-3" role="alert" invisible="farm_work_entries_count == 0">
                        <i class="fa fa-calculator fa-2x me-3" title="Work Breakdown Calculator"></i>
                        <div>
                            <strong>Agricultural Work Breakdown:</strong>
                            <span> <field name="farm_work_entries_count" class="fw-bold"/> work entries attached. Total Gross: <strong><field name="farm_work_total_amount" widget="monetary"/></strong></span>
                            <span invisible="farm_employee_type != 'temporary'"> (Total Days: <strong><field name="farm_work_days_count"/></strong>)</span>
                        </div>
                    </div>
                    <field name="farm_work_entry_ids" readonly="1">
                        <list decoration-success="payment_status == 'paid'" decoration-info="payment_status == 'in_payroll'" decoration-warning="payment_status == 'unpaid'">
                            <field name="date"/>
                            <field name="farm_id"/>
                            <field name="sub_unit_id"/>
                            <field name="activity_id" optional="show"/>
                            <field name="entry_type" widget="badge"/>
                            <field name="score_value" string="Score / Days"/>
                            <field name="norm_rate" string="Rate"/>
                            <field name="uom_name" string="Unit"/>
                            <field name="total_amount" sum="Total (Birr)" widget="monetary"/>
                            <field name="payment_status" widget="badge" decoration-success="payment_status == 'paid'" decoration-info="payment_status == 'in_payroll'" decoration-warning="payment_status == 'unpaid'"/>
                        </list>
                    </field>
                </page>
            </notebook>
        </field>
    </record>

    <!-- HR Payslip Batch Form Inherit: Farm Management Integration -->
    <record id="hr_payslip_run_form_farm_inherit" model="ir.ui.view">
        <field name="name">hr.payslip.run.form.farm.inherit</field>
        <field name="model">hr.payslip.run</field>
        <field name="inherit_id" ref="hr_payroll.hr_payslip_run_form"/>
        <field name="arch" type="xml">
            <!-- Add Action Button to Header -->
            <header position="inside">
                <button string="⚡ Generate Farm Payslips" name="action_generate_farm_payslips" type="object" class="btn-success" invisible="state != 'draft'"/>
            </header>

            <!-- Add Farm & Worker Classification Options -->
            <group position="after">
                <group string="Workforce &amp; Location Filters">
                    <group>
                        <field name="worker_type" widget="radio" options="{'horizontal': true}" readonly="state != 'draft'"/>
                        <field name="department_id" placeholder="All Departments (Optional)" readonly="state != 'draft'"/>
                        <field name="structure_id" options="{'no_create': True}" placeholder="All / Any Structure (Optional)" readonly="state != 'draft'"/>
                    </group>
                    <group>
                        <field name="farm_id" placeholder="All Farms (Optional)" readonly="state != 'draft'"/>
                        <field name="sub_farm_id" placeholder="All Sub Farms (Optional)" readonly="state != 'draft'" invisible="not farm_id"/>
                        <field name="sub_unit_id" placeholder="All Sub Units (Optional)" readonly="state != 'draft'" invisible="not farm_id and not sub_farm_id"/>
                    </group>
                </group>
                <group string="Agricultural Payout Summary" invisible="farm_work_entry_count == 0">
                    <group>
                        <field name="farm_worker_count" string="Workers Count"/>
                        <field name="farm_work_entry_count" string="Work Entries Included"/>
                    </group>
                    <group>
                        <field name="farm_total_amount" string="Total Agricultural Amount (Birr)" widget="monetary"/>
                    </group>
                </group>
            </group>
        </field>
    </record>

    <!-- HR Payslip Batch List View Inherit -->
    <record id="hr_payslip_run_tree_farm_inherit" model="ir.ui.view">
        <field name="name">hr.payslip.run.list.farm.inherit</field>
        <field name="model">hr.payslip.run</field>
        <field name="inherit_id" ref="hr_payroll.hr_payslip_run_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="structure_id" optional="show"/>
                <field name="farm_id" optional="show"/>
                <field name="sub_farm_id" optional="hide"/>
                <field name="sub_unit_id" optional="show"/>
                <field name="worker_type" optional="show" widget="badge"/>
            </xpath>
        </field>
    </record>

    <!-- HR Payslip Batch Search View Inherit -->
    <record id="hr_payslip_run_filter_farm_inherit" model="ir.ui.view">
        <field name="name">hr.payslip.run.filter.farm.inherit</field>
        <field name="model">hr.payslip.run</field>
        <field name="inherit_id" ref="hr_payroll.hr_payslip_run_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="structure_id"/>
                <field name="farm_id"/>
                <field name="sub_farm_id"/>
                <field name="sub_unit_id"/>
            </xpath>
            <xpath expr="//filter[@name='state']" position="after">
                <filter string="Salary Structure" name="group_by_structure" context="{'group_by': 'structure_id'}"/>
                <filter string="Farm" name="group_by_farm" context="{'group_by': 'farm_id'}"/>
                <filter string="Sub Unit" name="group_by_sub_unit" context="{'group_by': 'sub_unit_id'}"/>
            </xpath>
        </field>
    </record>

    <!-- HR Payslip Search View Inherit: Add Gender, Classification, and Farm Location -->
    <record id="view_hr_payslip_filter_farm_inherit" model="ir.ui.view">
        <field name="name">hr.payslip.select.farm.inherit</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="hr_payroll.view_hr_payslip_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='employee_id']" position="after">
                <field name="gender"/>
                <field name="farm_id"/>
                <field name="sub_unit_id"/>
            </xpath>
            <xpath expr="//filter[@name='group_by_employee_id']" position="after">
                <filter string="Gender" name="group_by_gender" context="{'group_by': 'gender'}"/>
                <filter string="Worker Classification" name="group_by_farm_employee_type" context="{'group_by': 'farm_employee_type'}"/>
                <filter string="Farm Location" name="group_by_farm" context="{'group_by': 'farm_id'}"/>
            </xpath>
        </field>
    </record>

    <!-- HR Payslip by Employees Wizard Inherit: Flexible Mode (All, Department, Classification, Custom) -->
    <record id="view_hr_payslip_by_employees_farm_inherit" model="ir.ui.view">
        <field name="name">hr.payslip.employees.form.farm.inherit</field>
        <field name="model">hr.payslip.employees</field>
        <field name="inherit_id" ref="hr_payroll.view_hr_payslip_by_employees"/>
        <field name="arch" type="xml">
            <!-- 1. Selection Mode Header Card -->
            <xpath expr="//span[1]" position="after">
                <div class="card mb-3 border bg-light p-3 rounded shadow-sm">
                    <label for="generation_mode" class="fw-bold mb-2 text-primary d-block" style="font-size: 1.05rem;">
                        <i class="fa fa-sliders me-1"/> Select Generation Mode / የማመንጫ ዘዴ ይምረጡ:
                    </label>
                    <field name="generation_mode" widget="radio" options="{'horizontal': true}"/>

                    <div class="alert alert-success d-flex align-items-center mt-2 mb-0 py-2" role="status" invisible="generation_mode != 'all'">
                        <i class="fa fa-users fa-lg me-2 text-success"/>
                        <div>
                            <strong>All Employees Mode (ለሁሉም ሰራተኞች):</strong>
                            Generates payslips for all active employees across the entire organization at once. Contracts are verified automatically.
                        </div>
                    </div>

                    <div class="alert alert-info d-flex align-items-center mt-2 mb-0 py-2" role="status" invisible="generation_mode != 'department'">
                        <i class="fa fa-building fa-lg me-2 text-info"/>
                        <div>
                            <strong>By Department Mode (በክፍል / በዲፓርትመንት):</strong>
                            Select a Department below to generate payslips for all employees in that department and sub-departments.
                        </div>
                    </div>

                    <div class="alert alert-warning d-flex align-items-center mt-2 mb-0 py-2" role="status" invisible="generation_mode != 'worker_type'">
                        <i class="fa fa-tractor fa-lg me-2 text-warning"/>
                        <div>
                            <strong>By Worker Classification Mode (በሰራተኛ ዓይነት / እርሻ):</strong>
                            Filter by agricultural workforce classification (Farm Staff, Head Office, Temporary, Seasonal/Zemach, CPW).
                        </div>
                    </div>
                </div>
            </xpath>

            <!-- 2. Dynamic Field Visibility -->
            <xpath expr="//separator[1]" position="attributes">
                <attribute name="invisible">generation_mode == 'all'</attribute>
            </xpath>

            <xpath expr="//field[@name='department_id']" position="attributes">
                <attribute name="invisible">generation_mode not in ('department', 'custom')</attribute>
                <attribute name="required">generation_mode == 'department'</attribute>
                <attribute name="placeholder">Select Department...</attribute>
            </xpath>

            <xpath expr="//field[@name='department_id']" position="after">
                <field name="worker_type" widget="radio" options="{'horizontal': true}" invisible="generation_mode != 'worker_type'"/>
                <field name="farm_id" placeholder="All Farms (Optional)" invisible="generation_mode != 'worker_type'"/>
                <field name="sub_farm_id" placeholder="All Sub Farms (Optional)" invisible="generation_mode != 'worker_type' or not farm_id"/>
                <field name="sub_unit_id" placeholder="All Sub Units (Optional)" invisible="generation_mode != 'worker_type' or not farm_id and not sub_farm_id"/>
            </xpath>

            <xpath expr="//field[@name='job_id'][1]" position="attributes">
                <attribute name="invisible">generation_mode != 'custom' or not department_id</attribute>
            </xpath>

            <xpath expr="//field[@name='job_id'][2]" position="attributes">
                <attribute name="invisible">generation_mode != 'custom' or department_id</attribute>
            </xpath>

            <xpath expr="//field[@name='structure_type_id']" position="attributes">
                <attribute name="invisible">generation_mode != 'custom'</attribute>
            </xpath>

            <!-- 3. Employees Header with Selected Count Badge -->
            <xpath expr="//separator[3]" position="replace">
                <div class="d-flex align-items-center justify-content-between mb-2 mt-3">
                    <separator string="Employees / ሰራተኞች" class="m-0"/>
                    <span class="badge text-bg-primary fs-6 px-3 py-2">
                        <i class="fa fa-users me-1"/> Selected Employees: <field name="selected_employee_count" class="fw-bold text-white"/>
                    </span>
                </div>
            </xpath>
        </field>
    </record>
</odoo>

