<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Work Entry Sequence -->
    <data noupdate="1">
        <record id="seq_farm_work_entry" model="ir.sequence">
            <field name="name">Farm Work Entry</field>
            <field name="code">farm.work.entry</field>
            <field name="prefix">WE/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>

    <!-- Work Entry List View -->
    <record id="view_farm_work_entry_list" model="ir.ui.view">
        <field name="name">farm.work.entry.list</field>
        <field name="model">farm.work.entry</field>
        <field name="arch" type="xml">
            <list string="Farm Work Entries" decoration-info="state == 'draft'" decoration-warning="state == 'confirmed'" decoration-success="payment_status == 'paid'" decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="date"/>
                <field name="employee_id" widget="many2one_avatar_employee"/>
                <field name="fms_employee_id" optional="show"/>
                <field name="entry_type" widget="badge" decoration-info="entry_type == 'piece_rate'" decoration-warning="entry_type == 'temporary_rate'"/>
                <field name="farm_id"/>
                <field name="sub_unit_id"/>
                <field name="activity_id" invisible="entry_type == 'temporary_rate'"/>
                <field name="score_value" string="Score / Days" sum="Total Score"/>
                <field name="norm_rate" string="Applied Rate"/>
                <field name="uom_name" string="Unit"/>
                <field name="total_amount" sum="Total Payment (Birr)" widget="monetary" decoration-bf="1"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-warning="state == 'confirmed'" decoration-success="state == 'approved'" decoration-muted="state == 'cancelled'"/>
                <field name="payment_status" widget="badge" decoration-warning="payment_status == 'unpaid'" decoration-info="payment_status == 'in_payroll'" decoration-success="payment_status == 'paid'"/>
                <field name="payslip_id" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Work Entry Form View -->
    <record id="view_farm_work_entry_form" model="ir.ui.view">
        <field name="name">farm.work.entry.form</field>
        <field name="model">farm.work.entry</field>
        <field name="arch" type="xml">
            <form string="Farm Work Entry">
                <header>
                    <button name="action_confirm" string="Confirm" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_approve" string="Approve" type="object" class="btn-success" invisible="state != 'confirmed'"/>
                    <button name="action_draft" string="Reset to Draft" type="object" invisible="state not in ('confirmed', 'cancelled') or payment_status == 'paid'"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state in ('approved', 'cancelled') or payment_status == 'paid'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group name="entry_type_grp" string="Payment Category &amp; Date">
                            <field name="entry_type" widget="radio" options="{'horizontal': true}" readonly="state == 'approved' or payment_status == 'paid'"/>
                            <field name="date" readonly="state == 'approved' or payment_status == 'paid'"/>
                            <field name="employee_id" widget="many2one_avatar_employee" readonly="state == 'approved' or payment_status == 'paid'"/>
                            <field name="fms_employee_id"/>
                            <field name="employee_type" widget="badge" decoration-primary="employee_type == 'permanent'" decoration-warning="employee_type == 'temporary'" decoration-info="employee_type == 'zemach'"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group name="location_details" string="Farm Deployment Location (Autofilled from Employee ID)">
                            <field name="farm_id" readonly="1"/>
                            <field name="sub_farm_id" readonly="1"/>
                            <field name="sub_unit_id" readonly="1"/>
                            <field name="block_id" options="{'no_create': True}" readonly="state == 'approved' or payment_status == 'paid'"/>
                        </group>
                    </group>

                    <!-- Piece Rate Section -->
                    <group invisible="entry_type != 'piece_rate'">
                        <group name="activity_calculation" string="Activity &amp; Productivity Score">
                            <field name="activity_id" options="{'no_create': True}" required="entry_type == 'piece_rate'" readonly="state == 'approved' or payment_status == 'paid'"/>
                            <field name="activity_code"/>
                            <field name="score_value" string="Score / Quantity" readonly="state == 'approved' or payment_status == 'paid'" class="oe_inline fw-bold" style="max-width: 150px;"/>
                        </group>
                        <group name="payment_calculation" string="Norm Rate &amp; Deserved Payment">
                            <label for="norm_rate" string="Norm Rate"/>
                            <div class="d-flex align-items-baseline">
                                <field name="norm_rate" readonly="state == 'approved' or payment_status == 'paid'" class="oe_inline fw-bold" style="max-width: 150px;"/>
                                <span class="ms-2 text-muted fw-bold"><field name="uom_name"/></span>
                            </div>
                            <div class="d-flex flex-column mt-2 p-3 bg-light rounded border">
                                <span class="text-muted small">Total Calculated Payment:</span>
                                <h2 class="text-success fw-bold mb-0">
                                    <field name="total_amount"/> <span class="fs-5">Birr</span>
                                </h2>
                                <span class="text-muted small mt-1">(Score × Norm Rate)</span>
                            </div>
                        </group>
                    </group>

                    <!-- Temporary Worker Daily Wage Section -->
                    <group invisible="entry_type != 'temporary_rate'">
                        <group name="temp_work_calculation" string="Temporary Attendance Duration">
                            <field name="work_duration" widget="radio" options="{'horizontal': true}" readonly="state == 'approved' or payment_status == 'paid'"/>
                            <field name="score_value" string="Days (0.5 / 1.0 / 1.5)" readonly="state == 'approved' or payment_status == 'paid'" class="oe_inline fw-bold" style="max-width: 150px;"/>
                            <field name="temporary_rate_id" readonly="1"/>
                        </group>
                        <group name="temp_payment_calculation" string="Daily Wage Rate &amp; Payment">
                            <label for="norm_rate" string="Applied Rate"/>
                            <div class="d-flex align-items-baseline">
                                <field name="norm_rate" readonly="state == 'approved' or payment_status == 'paid'" class="oe_inline fw-bold" style="max-width: 150px;"/>
                                <span class="ms-2 text-muted fw-bold"><field name="uom_name"/></span>
                            </div>
                            <div class="d-flex flex-column mt-2 p-3 bg-light rounded border border-primary">
                                <span class="text-muted small">Total Temporary Worker Payment:</span>
                                <h2 class="text-success fw-bold mb-0">
                                    <field name="total_amount"/> <span class="fs-5">Birr</span>
                                </h2>
                                <span class="text-muted small mt-1">(Calculated via Farm Temporary Rate: 1.0 Day / 0.5 Day / 1.5 Days)</span>
                            </div>
                        </group>
                    </group>

                    <!-- Payroll & Settlement Tracking Section -->
                    <group string="Payroll &amp; Settlement Tracking">
                        <group>
                            <field name="payment_status" widget="badge" decoration-warning="payment_status == 'unpaid'" decoration-info="payment_status == 'in_payroll'" decoration-success="payment_status == 'paid'"/>
                            <field name="paid_date" invisible="not paid_date"/>
                        </group>
                        <group>
                            <field name="payslip_id" readonly="1" invisible="not payslip_id"/>
                            <field name="payslip_run_id" readonly="1" invisible="not payslip_run_id"/>
                        </group>
                    </group>

                    <notebook>
                        <page name="remarks" string="Notes &amp; Description">
                            <field name="notes" placeholder="Additional notes, quality grading, shift remarks..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Work Entry Pivot View -->
    <record id="view_farm_work_entry_pivot" model="ir.ui.view">
        <field name="name">farm.work.entry.pivot</field>
        <field name="model">farm.work.entry</field>
        <field name="arch" type="xml">
            <pivot string="Work Entries &amp; Labor Cost Analysis" sample="1">
                <field name="activity_id" type="row"/>
                <field name="farm_id" type="row"/>
                <field name="employee_type" type="row"/>
                <field name="payment_status" type="col"/>
                <field name="score_value" type="measure" string="Work Done (Units/Score)"/>
                <field name="work_days" type="measure" string="Days Worked"/>
                <field name="total_amount" type="measure" string="Total Deserved (Birr)"/>
                <field name="amount_paid" type="measure" string="Paid (Birr)"/>
                <field name="amount_unpaid" type="measure" string="Unpaid (Birr)"/>
                <field name="entry_count" type="measure" string="Entries Count"/>
            </pivot>
        </field>
    </record>

    <!-- Work Entry Graph View: Top Activities Output & Cost (Bar) -->
    <record id="view_farm_work_entry_graph" model="ir.ui.view">
        <field name="name">farm.work.entry.graph</field>
        <field name="model">farm.work.entry</field>
        <field name="arch" type="xml">
            <graph string="Top Farm Activities: Output &amp; Labor Cost" type="bar" sample="1">
                <field name="activity_id"/>
                <field name="score_value" type="measure" string="Work Output"/>
                <field name="total_amount" type="measure" string="Total Payment (Birr)"/>
            </graph>
        </field>
    </record>

    <!-- Work Entry Graph View: Activity Labor Cost Share / Percentages (Pie) -->
    <record id="view_farm_work_entry_graph_pie" model="ir.ui.view">
        <field name="name">farm.work.entry.graph.pie</field>
        <field name="model">farm.work.entry</field>
        <field name="arch" type="xml">
            <graph string="Activity Labor Cost Share (%)" type="pie" sample="1">
                <field name="activity_id"/>
                <field name="total_amount" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Work Entry Graph View: Payment Status Distribution (Pie) -->
    <record id="view_farm_work_entry_graph_payment_status" model="ir.ui.view">
        <field name="name">farm.work.entry.graph.status</field>
        <field name="model">farm.work.entry</field>
        <field name="arch" type="xml">
            <graph string="Payment Status Distribution (Paid vs Unpaid)" type="pie" sample="1">
                <field name="payment_status"/>
                <field name="total_amount" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Work Entry Graph View: Labor Cost by Worker Classification (Bar) -->
    <record id="view_farm_work_entry_graph_worker" model="ir.ui.view">
        <field name="name">farm.work.entry.graph.worker</field>
        <field name="model">farm.work.entry</field>
        <field name="arch" type="xml">
            <graph string="Labor Cost by Worker Classification" type="bar" sample="1">
                <field name="employee_type"/>
                <field name="total_amount" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Work Entry Search View -->
    <record id="view_farm_work_entry_search" model="ir.ui.view">
        <field name="name">farm.work.entry.search</field>
        <field name="model">farm.work.entry</field>
        <field name="arch" type="xml">
            <search string="Search Work Entries">
                <field name="name" string="Reference"/>
                <field name="employee_id" string="Worker"/>
                <field name="fms_employee_id" string="Employee ID"/>
                <field name="farm_id"/>
                <field name="sub_farm_id"/>
                <field name="sub_unit_id"/>
                <field name="block_id"/>
                <field name="activity_id"/>
                <field name="payslip_id"/>
                <field name="payslip_run_id"/>

                <!-- Time Filters -->
                <separator/>
                <filter string="This Month" name="filter_this_month"
                        domain="[('date', '&gt;=', (context_today()).strftime('%Y-%m-01')), ('date', '&lt;=', (context_today() + relativedelta(months=1, day=1, days=-1)).strftime('%Y-%m-%d'))]"/>
                <filter string="Last Month" name="filter_last_month"
                        domain="[('date', '&gt;=', (context_today() - relativedelta(months=1, day=1)).strftime('%Y-%m-%d')), ('date', '&lt;=', (context_today() - relativedelta(day=1, days=1)).strftime('%Y-%m-%d'))]"/>
                <filter string="Today" name="filter_today"
                        domain="[('date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="This Year" name="filter_this_year"
                        domain="[('date', '&gt;=', context_today().strftime('%Y-01-01')), ('date', '&lt;=', context_today().strftime('%Y-12-31'))]"/>

                <!-- Settlement & Payment Status Filters -->
                <separator/>
                <filter string="Unpaid (Pending Liability)" name="filter_unpaid" domain="[('payment_status', '=', 'unpaid')]"/>
                <filter string="In Payroll Batch" name="filter_in_payroll" domain="[('payment_status', '=', 'in_payroll')]"/>
                <filter string="Paid &amp; Settled" name="filter_paid" domain="[('payment_status', '=', 'paid')]"/>

                <!-- Payment & Worker Type Filters -->
                <separator/>
                <filter string="Piece Rate (Norms)" name="filter_piece_rate" domain="[('entry_type', '=', 'piece_rate')]"/>
                <filter string="Temporary (Daily Rates)" name="filter_temporary_rate" domain="[('entry_type', '=', 'temporary_rate')]"/>
                <separator/>
                <filter string="Permanent Workers" name="filter_perm_workers" domain="[('employee_type', '=', 'permanent')]"/>
                <filter string="Seasonal Workers (Zemach)" name="filter_zemach_workers" domain="[('employee_type', '=', 'zemach')]"/>
                <filter string="Temporary Workers" name="filter_temp_workers" domain="[('employee_type', '=', 'temporary')]"/>
                <separator/>
                <filter string="Draft" name="state_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Confirmed" name="state_confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter string="Approved" name="state_approved" domain="[('state', '=', 'approved')]"/>

                <!-- Group By Grouping -->
                <group expand="0" string="Group By">
                    <filter string="Activity (Most Done)" name="group_activity" context="{'group_by': 'activity_id'}"/>
                    <filter string="Farm Location" name="group_farm" context="{'group_by': 'farm_id'}"/>
                    <filter string="Sub Farm" name="group_sub_farm" context="{'group_by': 'sub_farm_id'}"/>
                    <filter string="Sub Unit / Block" name="group_sub_unit" context="{'group_by': 'sub_unit_id'}"/>
                    <filter string="Worker Classification" name="group_employee_type" context="{'group_by': 'employee_type'}"/>
                    <filter string="Payment Status" name="group_payment_status" context="{'group_by': 'payment_status'}"/>
                    <filter string="Payment Type" name="group_entry_type" context="{'group_by': 'entry_type'}"/>
                    <filter string="Worker" name="group_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Work Date: Month" name="group_date_month" context="{'group_by': 'date:month'}"/>
                    <filter string="Work Date: Week" name="group_date_week" context="{'group_by': 'date:week'}"/>
                    <filter string="Work Date: Day" name="group_date_day" context="{'group_by': 'date:day'}"/>
                    <filter string="Payslip Batch" name="group_payslip_run" context="{'group_by': 'payslip_run_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action Work Entry: All Work Entries -->
    <record id="action_farm_work_entry" model="ir.actions.act_window">
        <field name="name">Work Entries</field>
        <field name="res_model">farm.work.entry</field>
        <field name="view_mode">list,form,pivot,graph</field>
        <field name="search_view_id" ref="view_farm_work_entry_search"/>
        <field name="context">{'search_default_filter_this_month': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Record a Farm Work Entry!
            </p>
            <p>
                Work entries record piece-rate activity scores (calculated via Norms) and temporary/seasonal daily attendance (calculated via Full Day / Half Day Wage Rates).
            </p>
        </field>
    </record>

    <!-- Action Work Entry: Unpaid Work Entries (Payroll Queue) -->
    <record id="action_farm_work_entry_unpaid" model="ir.actions.act_window">
        <field name="name">Unpaid Work Entries (Payroll Queue)</field>
        <field name="res_model">farm.work.entry</field>
        <field name="view_mode">list,form,pivot,graph</field>
        <field name="search_view_id" ref="view_farm_work_entry_search"/>
        <field name="domain">[('payment_status', '=', 'unpaid')]</field>
        <field name="context">{'search_default_filter_unpaid': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No unpaid work entries pending payroll!
            </p>
            <p>
                All submitted work entries have been processed and settled in payroll batches.
            </p>
        </field>
    </record>

    <!-- ================================================================= -->
    <!-- DEDICATED REPORTING ACTION: Work Entries & Labor Cost Analysis    -->
    <!-- ================================================================= -->
    <record id="action_farm_work_entry_report" model="ir.actions.act_window">
        <field name="name">Work Entries Analysis</field>
        <field name="res_model">farm.work.entry</field>
        <field name="view_mode">pivot,graph,list,form</field>
        <field name="search_view_id" ref="view_farm_work_entry_search"/>
        <field name="context">{
            'search_default_filter_this_month': 1,
            'search_default_group_activity': 1,
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No work entries recorded for this period!
            </p>
            <p>
                Analyze work output volume, activities performed most, days worked, and labor costs paid and pending settlement across all farms and worker classifications.
            </p>
        </field>
    </record>

    <!-- Reporting View Bindings -->
    <record id="action_farm_work_entry_report_pivot_view" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">pivot</field>
        <field name="view_id" ref="view_farm_work_entry_pivot"/>
        <field name="act_window_id" ref="action_farm_work_entry_report"/>
    </record>

    <record id="action_farm_work_entry_report_graph_view" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">graph</field>
        <field name="view_id" ref="view_farm_work_entry_graph"/>
        <field name="act_window_id" ref="action_farm_work_entry_report"/>
    </record>

    <record id="action_farm_work_entry_report_list_view" model="ir.actions.act_window.view">
        <field name="sequence" eval="3"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_farm_work_entry_list"/>
        <field name="act_window_id" ref="action_farm_work_entry_report"/>
    </record>
</odoo>
