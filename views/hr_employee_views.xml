<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- HR Employee Form Inherit -->
    <record id="view_employee_form_farm_inherit" model="ir.ui.view">
        <field name="name">hr.employee.form.farm.inherit</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <!-- Smart Buttons in Employee Header -->
            <div name="button_box" position="inside">
                <button name="action_view_managed_farms"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-tree"
                        invisible="managed_farm_count == 0">
                    <field name="managed_farm_count" widget="statinfo" string="Managed Farms"/>
                </button>
                    <button name="action_view_transfers"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-exchange"
                        invisible="transfer_count == 0 or farm_employee_type == 'head_office'">
                    <field name="transfer_count" widget="statinfo" string="Transfers"/>
                </button>
                <button name="action_view_work_entries"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-tasks"
                        invisible="work_entry_count == 0 or farm_employee_type == 'head_office'">
                    <field name="work_entry_count" widget="statinfo" string="Work Entries"/>
                </button>
                <button name="action_view_unpaid_work_entries"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-money"
                        invisible="unpaid_work_entry_count == 0 or farm_employee_type == 'head_office'">
                    <field name="unpaid_work_entry_count" widget="statinfo" string="Unpaid Entries"/>
                </button>
            </div>


            <!-- Mandatory Classification & Location Placement -->
            <xpath expr="//notebook" position="before">
                <div class="card p-3 mb-3 border-primary bg-light">

                    <h5 class="text-primary mb-3"><i class="fa fa-id-badge me-2"/>Employee Classification &amp; Location Placement</h5>
                    <div class="row">
                        <div class="col-md-6">
                            <group>
                                <field name="farm_employee_type" widget="radio" options="{'horizontal': false}" required="1"/>
                                <label for="fms_employee_id" string="Employee ID"/>
                                <div>
                                    <field name="fms_employee_id" readonly="1" class="fw-bold fs-4 text-primary font-monospace"/>
                                    <div class="text-muted small" invisible="farm_employee_type != 'head_office'">Head Office format: <strong>HQ001, HQ002...</strong></div>
                                    <div class="text-muted small" invisible="farm_employee_type == 'head_office'">Farm format: <strong>[FarmCode][Type: P/T/Z][SequentialNumber]</strong></div>
                                </div>
                                <label for="birthday" string="Date of Birth (DOB)"/>
                                <div>
                                    <div class="d-flex align-items-center">
                                        <field name="birthday" required="1" placeholder="Select Date of Birth..." class="me-2"/>
                                        <span class="badge text-bg-success fs-6" invisible="not birthday or age &lt; 18">
                                            Age: <field name="age" readonly="1"/> yrs
                                        </span>
                                        <span class="badge text-bg-danger fs-6" invisible="not birthday or age &gt;= 18">
                                            <i class="fa fa-ban me-1"/>Underage (<field name="age" readonly="1"/> yrs &lt; 18)
                                        </span>
                                    </div>
                                    <div class="text-muted small">Mandatory legal requirement (18+ years old).</div>
                                </div>
                            </group>
                        </div>
                        <div class="col-md-6" invisible="farm_employee_type == 'head_office'">
                            <group>
                                <field name="initial_farm_id" options="{'no_create': True}" required="farm_employee_type != 'head_office'" placeholder="Select Farm..."/>
                                <field name="initial_sub_farm_id" options="{'no_create': True}" required="farm_employee_type != 'head_office'" placeholder="Select Sub Farm..."/>
                                <field name="initial_sub_unit_id" options="{'no_create': True}" required="farm_employee_type != 'head_office'" placeholder="Select Sub Unit..."/>
                                <field name="initial_block_id" options="{'no_create': True}" placeholder="Select Block (Optional)..."/>
                            </group>
                        </div>
                        <div class="col-md-6" invisible="farm_employee_type != 'head_office'">
                            <div class="alert alert-info d-flex align-items-center mt-3 p-3">
                                <i class="fa fa-building fs-2 me-3 text-info"/>
                                <div>
                                    <h6 class="mb-1 fw-bold">Head Office Permanent Staff</h6>
                                    <p class="mb-0 small text-muted">Stationed permanently at Head Office (ዋና መ/ቤት). No agricultural farm placement or field transfer is required.</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Permanent Staff Salary Scale & Placement (Reflected from Active Contract) -->
                    <div class="mt-3 pt-3 border-top" invisible="farm_employee_type in ('temporary', 'zemach')">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h6 class="text-success mb-0"><i class="fa fa-calculator me-2"/>Contract Salary Matrix Placement</h6>
                            <span class="badge text-bg-success fs-6" invisible="matrix_basic_wage == 0">
                                Contract Basic Wage: <field name="matrix_basic_wage" widget="monetary" readonly="1" class="text-white fw-bold"/>
                            </span>
                        </div>
                        <div class="row" invisible="not salary_matrix_type">
                            <div class="col-md-4">
                                <group>
                                    <field name="salary_matrix_type" readonly="1"/>
                                </group>
                            </div>
                            <div class="col-md-4">
                                <group>
                                    <field name="salary_grade" readonly="1"/>
                                </group>
                            </div>
                            <div class="col-md-4">
                                <group>
                                    <field name="salary_level" readonly="1"/>
                                </group>
                            </div>
                        </div>
                        <div class="text-muted small" invisible="salary_matrix_type">
                            <i class="fa fa-info-circle me-1"/>Salary Matrix Scale, Grade, and Level are configured in the employee's <strong>Contract</strong>.
                        </div>
                    </div>
                </div>
            </xpath>


            <!-- Dedicated Notebook Page for Agricultural Assignments & Transfer History -->
            <xpath expr="//notebook" position="inside">
                <page name="farm_assignments" string="Farm Assignments" groups="farm_management.group_farm_user" invisible="farm_employee_type == 'head_office'">
                    <!-- Live Structural Hierarchy Banner -->
                    <div class="mb-4">
                        <h4 class="text-primary mb-2"><i class="fa fa-sitemap me-2"/>Current Placement &amp; Management Roles</h4>
                        <field name="farm_structure_hierarchy_display" widget="html" readonly="1" nolabel="1"/>
                    </div>

                    <!-- Management Scope: Easily assign employee as Manager / Supervisor -->
                    <group string="Management Scope &amp; Supervision (Farms / Units Managed)">
                        <group>
                            <field name="managed_farm_ids" widget="many2many_tags" options="{'no_create': True}" placeholder="Select farms to manage..."/>
                            <field name="managed_sub_farm_ids" widget="many2many_tags" options="{'no_create': True}" placeholder="Select sub farms to manage..."/>
                        </group>
                        <group>
                            <field name="managed_sub_unit_ids" widget="many2many_tags" options="{'no_create': True}" placeholder="Select sub units to manage..."/>
                            <field name="supervised_block_ids" widget="many2many_tags" options="{'no_create': True}" placeholder="Select blocks to supervise..."/>
                        </group>
                    </group>

                    <!-- Transfer & Assignment History Table -->
                    <group string="Transfer &amp; Assignment History (Movement between Sub Units &amp; Blocks)">
                        <field name="transfer_history_ids" context="{'default_employee_id': id}">
                            <list string="Transfer &amp; Assignment History" editable="bottom">
                                <field name="transfer_date" string="Transfer Date"/>
                                <field name="moving_date" string="Moving Date" placeholder="Active if empty"/>
                                <field name="farm_id" options="{'no_create': True}"/>
                                <field name="sub_farm_id" options="{'no_create': True}"/>
                                <field name="sub_unit_id" options="{'no_create': True}"/>
                                <field name="block_id" options="{'no_create': True}"/>
                                <field name="status" widget="badge" decoration-success="status == 'active'" decoration-muted="status == 'completed'"/>
                                <field name="notes" placeholder="e.g. Seasonal rotation, promotion..."/>
                            </list>
                        </field>
                    </group>
                </page>

                <!-- Dedicated Page for Work Entries -->
                <page name="farm_work_entries" string="Work Entries" groups="farm_management.group_farm_user" invisible="farm_employee_type == 'head_office'">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div>
                            <span class="text-muted">Total Calculated Earnings: </span>
                            <span class="fs-4 fw-bold text-success"><field name="total_earned_amount" widget="monetary"/> Birr</span>
                        </div>
                        <div class="d-flex gap-2">
                            <span class="badge bg-warning text-dark p-2" invisible="unpaid_work_entry_count == 0"><i class="fa fa-clock-o me-1"/>Unpaid: <field name="unpaid_work_entry_amount" widget="monetary"/> Birr (<field name="unpaid_work_entry_count"/>)</span>
                            <span class="badge bg-success p-2" invisible="paid_work_entry_amount == 0"><i class="fa fa-check-circle me-1"/>Paid: <field name="paid_work_entry_amount" widget="monetary"/> Birr</span>
                        </div>
                    </div>
                    <field name="work_entry_ids" context="{'default_employee_id': id}">
                        <list string="Work Entries" editable="bottom">
                            <field name="date"/>
                            <field name="farm_id" options="{'no_create': True}"/>
                            <field name="sub_unit_id" options="{'no_create': True}"/>
                            <field name="entry_type" widget="badge"/>
                            <field name="activity_id" options="{'no_create': True}"/>
                            <field name="score_value" string="Score / Days"/>
                            <field name="norm_rate" string="Rate"/>
                            <field name="uom_name" string="Unit"/>
                            <field name="total_amount" sum="Total" decoration-bf="1"/>
                            <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-warning="state == 'confirmed'" decoration-success="state == 'approved'" decoration-muted="state == 'cancelled'"/>
                            <field name="payment_status" widget="badge" decoration-warning="payment_status == 'unpaid'" decoration-info="payment_status == 'in_payroll'" decoration-success="payment_status == 'paid'"/>
                        </list>
                    </field>
                </page>
            </xpath>

            <!-- Family Members Section inside Private Information page -->
            <xpath expr="//page[@name='personal_information']/group" position="inside">
                <group string="Family Members" colspan="2">
                    <field name="family_member_ids" nolabel="1" colspan="2">
                        <list editable="bottom" string="Family Members">
                            <field name="name" string="Name" placeholder="Full Name (e.g. Abebech Tadesse)..." required="1"/>
                            <field name="relationship" string="Relationship" required="1"/>
                            <field name="birthday" string="Date of Birth" invisible="relationship != 'children'" required="relationship == 'children'"/>
                            <field name="age" string="Age (Years)" readonly="1" invisible="relationship != 'children'"/>
                        </list>
                    </field>
                </group>
            </xpath>
        </field>
    </record>

    <!-- HR Employee List View Inherit -->
    <record id="view_employee_tree_farm_inherit" model="ir.ui.view">
        <field name="name">hr.employee.list.farm.inherit</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_tree"/>
        <field name="arch" type="xml">
            <field name="name" position="before">
                <field name="fms_employee_id" string="Employee ID" optional="show" decoration-bf="1"/>
            </field>
            <field name="work_email" position="after">
                <field name="farm_employee_type" widget="badge" decoration-success="farm_employee_type == 'head_office'" decoration-primary="farm_employee_type == 'permanent'" decoration-warning="farm_employee_type == 'temporary'" decoration-info="farm_employee_type == 'zemach'" optional="show"/>
                <field name="birthday" optional="show"/>
                <field name="age" string="Age" optional="show"/>
                <field name="current_farm_id" string="Farm" optional="show"/>
                <field name="current_sub_unit_id" string="Sub Unit" optional="show"/>
            </field>
        </field>
    </record>

    <!-- HR Employee Search View Inherit -->
    <record id="view_employee_filter_farm_inherit" model="ir.ui.view">
        <field name="name">hr.employee.search.farm.inherit</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_filter"/>
        <field name="arch" type="xml">
            <field name="name" position="before">
                <field name="fms_employee_id" string="Employee ID (FMS)"/>
            </field>
            <filter name="group_job" position="after">
                <separator/>
                <filter string="Head Office Permanent" name="filter_head_office" domain="[('farm_employee_type', '=', 'head_office')]"/>
                <filter string="Farm Permanent" name="filter_permanent" domain="[('farm_employee_type', '=', 'permanent')]"/>
                <filter string="Temporary Employees" name="filter_temporary" domain="[('farm_employee_type', '=', 'temporary')]"/>
                <filter string="Zemach Employees" name="filter_zemach" domain="[('farm_employee_type', '=', 'zemach')]"/>
                <group expand="0" string="Farm Group By">
                    <filter string="Employee Classification" name="group_farm_employee_type" context="{'group_by': 'farm_employee_type'}"/>
                    <filter string="Current Farm" name="group_current_farm" context="{'group_by': 'current_farm_id'}"/>
                    <filter string="Sub Unit" name="group_current_sub_unit" context="{'group_by': 'current_sub_unit_id'}"/>
                </group>
            </filter>
        </field>
    </record>

    <!-- Inherit Employee Print Badge QWeb Template: Add Farm ID & Age -->
    <template id="print_employee_badge_farm_inherit" inherit_id="hr.print_employee_badge">
        <xpath expr="//div[@t-if='employee.barcode']" position="before">
            <div t-if="employee.fms_employee_id or employee.barcode" style="font-size: 11pt; font-weight: bold; color: #198754; margin-bottom: 2pt;">
                <span t-out="employee.fms_employee_id or employee.barcode"/>
            </div>
            <div t-if="employee.age" style="font-size: 9pt; color: #495057; font-weight: 600; margin-bottom: 3pt;">
                Age: <span t-out="employee.age"/> yrs
            </div>
        </xpath>
    </template>
</odoo>
