<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- HR Contract Form Inherit: Salary Matrix, Allowances, 6 Deduction Categories & Clean UI -->
    <record id="hr_contract_view_form_salary_matrix" model="ir.ui.view">
        <field name="name">hr.contract.form.salary.matrix</field>
        <field name="model">hr.contract</field>
        <field name="inherit_id" ref="hr_contract.hr_contract_view_form"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <!-- Prominent Salary Matrix Placement card under Salary Information -->
            <group name="salary_info" position="before">
                <div class="card p-3 mb-3 border-success bg-light" invisible="farm_employee_type in ('temporary', 'zemach')">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h5 class="text-success mb-0"><i class="fa fa-calculator me-2"/>Salary Matrix Placement (Grade &amp; Level Scale)</h5>
                        <span class="badge text-bg-success fs-6" invisible="matrix_basic_wage == 0">
                            Scale Basic Wage: <field name="matrix_basic_wage" widget="monetary" readonly="1" class="text-white fw-bold"/>
                        </span>
                    </div>
                    <p class="text-muted small mb-3">
                        Select the Scale Category, Grade, and Level. The contract monthly wage will be automatically populated based on the company salary matrix.
                    </p>
                    <div class="row">
                        <div class="col-md-4">
                            <group>
                                <field name="salary_matrix_type" widget="selection" placeholder="Select Scale Category..."/>
                            </group>
                        </div>
                        <div class="col-md-4">
                            <group>
                                <field name="salary_grade" placeholder="Select Grade (1–22)..." invisible="not salary_matrix_type"/>
                            </group>
                        </div>
                        <div class="col-md-4">
                            <group>
                                <field name="salary_level" placeholder="Select Step / Level..." invisible="not salary_grade"/>
                            </group>
                        </div>
                    </div>
                </div>
            </group>

            <!-- Replace standard salary_info with Allowances and Compensation Summary Cards -->
            <group name="salary_info" position="replace">
                <div class="row">
                    <!-- Left: Basic Wage & Allowances Breakdown -->
                    <div class="col-md-6 mb-3">
                        <div class="card h-100 border-primary bg-light shadow-sm">
                            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center py-2">
                                <strong class="mb-0"><i class="fa fa-money me-2"/>Basic Wage &amp; Allowances (አበሎች)</strong>
                                <span class="badge bg-light text-dark">Total Gross: <field name="gross_monthly_wage" widget="monetary" readonly="1"/></span>
                            </div>
                            <div class="card-body">
                                <group class="mb-0">
                                    <label for="wage" string="Basic Monthly Wage"/>
                                    <div class="o_row">
                                        <field name="wage" class="oe_inline o_hr_narrow_field fw-bold"/>
                                        <span class="text-muted ms-1">/ month</span>
                                    </div>

                                    <separator string="Transport &amp; Fuel Policy"/>
                                    <field name="transport_allowance_rule" widget="selection"/>
                                    <field name="allowance_transport" widget="monetary" string="Transport Allowance" invisible="transport_allowance_rule == 'none'"/>
                                    <field name="fuel_liters" invisible="1"/>
                                    <field name="fuel_price_per_liter" invisible="1"/>
                                    <div class="alert alert-info py-2 px-3 my-2 small d-flex align-items-center" invisible="transport_allowance_rule not in ('fuel_50', 'fuel_60')">
                                        <i class="fa fa-tint me-2 fs-5 text-primary"/>
                                        <div><strong>Fuel Entitlement:</strong> <field name="fuel_liters" readonly="1"/> Litres Fuel @ <field name="fuel_price_per_liter" readonly="1"/> Birr/Liter</div>
                                    </div>
                                    <div class="text-muted small my-1" invisible="transport_allowance_rule != 'fixed_4000'">
                                        <i class="fa fa-bus me-1 text-primary"/>Standard Fixed Rate: ETB 4,000 / month (Grade ≤ 17).
                                    </div>

                                    <separator string="Other Approved Allowances"/>
                                    <field name="allowance_hardship"/>
                                    <field name="allowance_overtime"/>

                                    <separator string="Back Pay &amp; Retroactive Adjustments (የተከማቸ ጭማሪ)"/>
                                    <div class="border rounded p-2 bg-white mb-2 shadow-sm">
                                        <div class="row g-2 mb-2">
                                            <div class="col-6">
                                                <label for="back_pay_months" string="Retroactive Months" class="small fw-bold"/>
                                                <field name="back_pay_months" class="form-control form-control-sm"/>
                                            </div>
                                            <div class="col-6">
                                                <label for="back_pay_previous_net" string="Previous Net / Month" class="small fw-bold"/>
                                                <field name="back_pay_previous_net" widget="monetary" class="form-control form-control-sm"/>
                                            </div>
                                        </div>
                                        <div class="row g-2 mb-2" invisible="back_pay_months == 0">
                                            <div class="col-6">
                                                <div class="text-muted small">New Corrected Net</div>
                                                <div class="fw-bold text-dark"><field name="back_pay_new_net" widget="monetary" readonly="1"/></div>
                                            </div>
                                            <div class="col-6">
                                                <div class="text-muted small">Monthly Difference</div>
                                                <div class="fw-bold text-primary">+ <field name="back_pay_monthly_diff" widget="monetary" readonly="1"/></div>
                                            </div>
                                        </div>
                                        <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                                            <div>
                                                <label for="allowance_retroactive" string="Total Back Pay (Non-Taxable)" class="small fw-bold text-success"/>
                                                <div class="fs-5 fw-bold text-success"><field name="allowance_retroactive" widget="monetary"/></div>
                                            </div>
                                            <div class="d-flex align-items-center gap-1">
                                                <field name="is_back_pay_approved" widget="boolean_toggle" options="{'autosave': true}"/>
                                                <span class="small fw-bold text-muted me-2" invisible="is_back_pay_approved">Pending Approval</span>
                                                <span class="badge text-bg-success" invisible="not is_back_pay_approved"><i class="fa fa-check me-1" title="Approved"/>Approved</span>
                                                <button name="action_approve_back_pay" type="object" string="Approve" class="btn btn-sm btn-outline-success" invisible="is_back_pay_approved or allowance_retroactive == 0"/>
                                                <button name="action_reset_back_pay" type="object" string="Reset" class="btn btn-sm btn-outline-secondary" invisible="allowance_retroactive == 0 and back_pay_months == 0"/>
                                            </div>
                                        </div>
                                        <field name="back_pay_justification" placeholder="Reason / justification (e.g. Promotion approved from Tir to Megabit)..." class="mt-2"/>
                                    </div>
                                    <field name="total_monthly_allowances" widget="monetary" readonly="1" class="fw-bold text-success"/>
                                </group>
                            </div>
                        </div>
                    </div>

                    <!-- Right: Monthly Compensation Summary KPI -->
                    <div class="col-md-6 mb-3">
                        <div class="card h-100 border-success shadow-sm">
                            <div class="card-header bg-success text-white py-2">
                                <strong class="mb-0"><i class="fa fa-pie-chart me-2"/>Monthly Compensation Summary</strong>
                            </div>
                            <div class="card-body d-flex flex-column justify-content-around">
                                <div class="p-3 border rounded bg-light mb-2">
                                    <div class="text-muted small">1. Basic Wage (መነሻ ደመወዝ)</div>
                                    <div class="fs-4 fw-bold text-dark"><field name="wage" widget="monetary" readonly="1"/></div>
                                </div>
                                <div class="p-3 border rounded bg-light mb-2">
                                    <div class="text-muted small">2. Total Monthly Allowances (ጠቅላላ አበሎች)</div>
                                    <div class="fs-4 fw-bold text-primary">+ <field name="total_monthly_allowances" widget="monetary" readonly="1"/></div>
                                </div>
                                <div class="p-3 border rounded bg-light mb-2">
                                    <div class="text-muted small">3. Total Gross Monthly Wage (ጠቅላላ ወርሃዊ ገቢ)</div>
                                    <div class="fs-4 fw-bold text-dark">= <field name="gross_monthly_wage" widget="monetary" readonly="1"/></div>
                                </div>
                                <div class="p-3 border rounded bg-light mb-2">
                                    <div class="text-muted small">4. Total Monthly Deductions (ጠቅላላ ተቀናሾች)</div>
                                    <div class="fs-4 fw-bold text-danger">- <field name="total_monthly_deductions" widget="monetary" readonly="1"/></div>
                                </div>
                                <div class="p-3 border border-success border-2 rounded bg-white shadow-sm">
                                    <div class="text-success small fw-bold text-uppercase"><i class="fa fa-check-circle me-1"/>5. Estimated Net Take-Home (የተጣራ ተገማች ደመወዝ)</div>
                                    <div class="fs-2 fw-bold text-success mt-1">= <field name="net_wage_after_deductions" widget="monetary" readonly="1"/></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </group>

            <!-- Dedicated Monthly Deductions Notebook Page -->
            <xpath expr="//notebook" position="inside">
                <page string="Monthly Deductions (ተቀናሾች)" name="monthly_deductions">
                    <!-- Top Summary Banner -->
                    <div class="card p-3 mb-4 border-primary bg-light">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h5 class="text-primary mb-1"><i class="fa fa-list-alt me-2"/>Contract Deductions Schedule</h5>
                                <div class="text-muted small">Configure fixed monthly deductions applicable to this employee contract.</div>
                            </div>
                            <div class="d-flex gap-3 text-end">
                                <div class="p-2 border rounded bg-white">
                                    <div class="text-muted small">Basic Gross Wage</div>
                                    <div class="fs-5 fw-bold text-dark"><field name="wage" widget="monetary" readonly="1"/></div>
                                </div>
                                <div class="p-2 border rounded bg-white">
                                    <div class="text-muted small">Total Deductions</div>
                                    <div class="fs-5 fw-bold text-danger"><field name="total_monthly_deductions" widget="monetary" readonly="1"/></div>
                                </div>
                                <div class="p-2 border rounded bg-white">
                                    <div class="text-muted small">Estimated Net</div>
                                    <div class="fs-5 fw-bold text-success"><field name="net_wage_after_deductions" widget="monetary" readonly="1"/></div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <!-- Category 1: Statutory & Mandatory Deductions -->
                        <div class="col-md-6 mb-3">
                            <div class="card h-100 shadow-sm border-secondary">
                                <div class="card-header bg-secondary text-white d-flex justify-content-between align-items-center py-2">
                                    <strong class="mb-0"><i class="fa fa-university me-2"/>1. Statutory &amp; Mandatory Deductions</strong>
                                    <span class="badge bg-light text-dark">Subtotal: <field name="total_statutory_deductions" widget="monetary" readonly="1"/></span>
                                </div>
                                <div class="card-body">
                                    <group class="mb-0">
                                        <field name="deduction_pension"/>
                                        <field name="deduction_income_tax"/>
                                        <field name="deduction_luc"/>
                                        <field name="deduction_credit_assoc_mandatory"/>
                                        <field name="deduction_social_contribution"/>
                                    </group>
                                </div>
                            </div>
                        </div>

                        <!-- Category 2: Loans, Advances & Recoveries -->
                        <div class="col-md-6 mb-3">
                            <div class="card h-100 shadow-sm border-warning">
                                <div class="card-header bg-warning text-dark d-flex justify-content-between align-items-center py-2">
                                    <strong class="mb-0"><i class="fa fa-money me-2"/>2. Loans, Advances &amp; Recoveries</strong>
                                    <span class="badge bg-dark text-white">Subtotal: <field name="total_loan_deductions" widget="monetary" readonly="1"/></span>
                                </div>
                                <div class="card-body">
                                    <group class="mb-0">
                                        <field name="deduction_advance"/>
                                        <field name="deduction_pre_payment"/>
                                        <field name="deduction_credit_assoc_loan"/>
                                        <field name="deduction_medical_recovery"/>
                                        <field name="deduction_pension_receivable"/>
                                        <field name="deduction_fine"/>
                                    </group>
                                </div>
                            </div>
                        </div>

                        <!-- Category 3: Employee Savings & Financial Contributions -->
                        <div class="col-md-6 mb-3">
                            <div class="card h-100 shadow-sm border-info">
                                <div class="card-header bg-info text-dark d-flex justify-content-between align-items-center py-2">
                                    <strong class="mb-0"><i class="fa fa-piggy-bank me-2"/>3. Employee Savings &amp; Contributions</strong>
                                    <span class="badge bg-dark text-white">Subtotal: <field name="total_savings_deductions" widget="monetary" readonly="1"/></span>
                                </div>
                                <div class="card-body">
                                    <group class="mb-0">
                                        <field name="deduction_saving_kossa"/>
                                        <field name="deduction_saving_jimma"/>
                                        <field name="deduction_suntu_saving"/>
                                        <field name="deduction_family_allotment"/>
                                        <field name="deduction_cost_sharing"/>
                                    </group>
                                </div>
                            </div>
                        </div>

                        <!-- Category 4: Employee Welfare & Services -->
                        <div class="col-md-6 mb-3">
                            <div class="card h-100 shadow-sm border-success">
                                <div class="card-header bg-success text-white d-flex justify-content-between align-items-center py-2">
                                    <strong class="mb-0"><i class="fa fa-heartbeat me-2"/>4. Employee Welfare &amp; Services</strong>
                                    <span class="badge bg-light text-dark">Subtotal: <field name="total_welfare_deductions" widget="monetary" readonly="1"/></span>
                                </div>
                                <div class="card-body">
                                    <group class="mb-0">
                                        <field name="deduction_ration"/>
                                        <field name="deduction_service"/>
                                        <field name="deduction_medical_8"/>
                                        <field name="deduction_church_contribution"/>
                                        <field name="deduction_kindergarten"/>
                                        <field name="deduction_cafeteria"/>
                                        <field name="deduction_school"/>
                                        <field name="deduction_sport"/>
                                        <field name="deduction_hiv"/>
                                    </group>
                                </div>
                            </div>
                        </div>

                        <!-- Category 5: Food, Meat & Consumable Deductions -->
                        <div class="col-md-6 mb-3">
                            <div class="card h-100 shadow-sm border-danger">
                                <div class="card-header bg-danger text-white d-flex justify-content-between align-items-center py-2">
                                    <strong class="mb-0"><i class="fa fa-cutlery me-2"/>5. Meat &amp; Consumable Deductions</strong>
                                    <span class="badge bg-light text-dark">Subtotal: <field name="total_food_deductions" widget="monetary" readonly="1"/></span>
                                </div>
                                <div class="card-body">
                                    <group class="mb-0">
                                        <field name="deduction_meat_meredaja"/>
                                        <field name="deduction_jimma_meat"/>
                                        <field name="deduction_suntu_meat"/>
                                    </group>
                                </div>
                            </div>
                        </div>

                        <!-- Category 6: Bank & Other Specific Deductions -->
                        <div class="col-md-6 mb-3">
                            <div class="card h-100 shadow-sm border-primary">
                                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center py-2">
                                    <strong class="mb-0"><i class="fa fa-bank me-2"/>6. Bank &amp; Other Specific Deductions</strong>
                                    <span class="badge bg-light text-dark">Subtotal: <field name="total_bank_deductions" widget="monetary" readonly="1"/></span>
                                </div>
                                <div class="card-body">
                                    <group class="mb-0">
                                        <field name="deduction_dashen_credit"/>
                                        <field name="deduction_dashen_saving"/>
                                        <field name="deduction_awash_credit"/>
                                        <field name="deduction_awash_saving"/>
                                        <field name="deduction_meredaja"/>
                                    </group>
                                </div>
                            </div>
                        </div>
                    </div>
                </page>
            </xpath>
        </field>
    </record>

    <!-- HR Contract Tree / List View Inherit: Show Allowances, Gross, Deductions & Net Wage -->
    <record id="hr_contract_view_tree_farm_inherit" model="ir.ui.view">
        <field name="name">hr.contract.list.farm.inherit</field>
        <field name="model">hr.contract</field>
        <field name="inherit_id" ref="hr_contract.hr_contract_view_tree"/>
        <field name="arch" type="xml">
            <field name="wage" position="after">
                <field name="total_monthly_allowances" widget="monetary" optional="show" string="Allowances"/>
                <field name="gross_monthly_wage" widget="monetary" optional="show" string="Gross Wage"/>
                <field name="total_monthly_deductions" widget="monetary" optional="show" string="Total Deductions"/>
                <field name="net_wage_after_deductions" widget="monetary" optional="show" string="Estimated Net Wage" decoration-bf="1"/>
            </field>
        </field>
    </record>
</odoo>
